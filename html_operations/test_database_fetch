class TestFetchDataForTitleDynamic(unittest.TestCase):

    @patch('mysql.connector.connect')  # Mock the MySQL connection
    @patch('QR.messagebox.showerror')  # Mock messagebox to avoid actual popups
    def test_fetch_data_success(self, mock_showerror, mock_connect):
        mock_connection = MagicMock()
        mock_cursor = MagicMock()
        mock_connect.return_value = mock_connection
        mock_connection.cursor.return_value = mock_cursor

        # Simulate cursor.fetchall() for tables with a 'title' column
        mock_cursor.fetchall.return_value = [('table1',), ('table2',)]

        # Simulate the query result for the title
        mock_cursor.execute.side_effect = [
            MagicMock(fetchone=MagicMock(return_value=(
                'Test Title', 'Test Description', 'img1.jpg', 'img2.jpg', 'img3.jpg', 'img4.jpg', 'img5.jpg', 
                'ref1', 'ref2', 'ref3', 'ref4', 'ref5', 'ref6', 'ref7', 'ref8', 'ref9', 'ref10', 
                'Test Location', 10, 20, 30, 
                'tag1', 'tag2', 'tag3', 'tag4', 'tag5', 'tag6', 'tag7', 'tag8', 'tag9', 'tag10', 
                'tag11', 'tag12', 'tag13', 'tag14', 'tag15'
            ))),  # For table1 (matching title)
            MagicMock(fetchone=MagicMock(return_value=None))  # For table2 (no matching title)
        ]

        # Call the function with a title that exists in the first table
        title = 'Test Title'
        detailed_info, table_name = fetch_data_for_title_dynamic(title)

        # Debugging: Print out the tables and check if they are being queried
        print("Tables found in the schema:", mock_cursor.fetchall.return_value)

        # Verify if fetchone was called on the correct table
        print("Calls to execute:", mock_cursor.execute.call_args_list)

        # Assert that the detailed info is returned for the title in the first table
        self.assertIsNotNone(detailed_info, "Detailed info should not be None")
        self.assertEqual(detailed_info['title'], 'Test Title')
        self.assertEqual(table_name, 'table1')

        # Verify that the database connection and query were executed
        mock_connect.assert_called_once_with(
            host="localhost",
            user="test_user",
            password="test_pass",
            database="museum"
        )
        mock_cursor.execute.assert_any_call("""SELECT TABLE_NAME FROM INFORMATION_SCHEMA.COLUMNS WHERE TABLE_SCHEMA = 'museum' AND COLUMN_NAME = 'title'""")
        mock_cursor.execute.assert_any_call(f"SELECT title, description, img_1, img_2, img_3, img_4, img_5, "
                                            f"reference_1, reference_2, reference_3, reference_4, reference_6, reference_7, reference_8, reference_9, reference_10, "
                                            f"location, hight, width, length, "
                                            f"tag_1, tag_2, tag_3, tag_4, tag_5, tag_6, tag_7, tag_8, tag_9, tag_10, "
                                            f"tag_11, tag_12, tag_13, tag_14, tag_15 "
                                            f"FROM `table1` WHERE title = %s", (title,))

    @patch('mysql.connector.connect')  # Mock the MySQL connection
    @patch('QR.messagebox.showerror')  # Mock messagebox to avoid actual popups
    def test_fetch_data_not_found(self, mock_showerror, mock_connect):
        # Mock the database connection and cursor
        mock_connection = MagicMock()
        mock_cursor = MagicMock()
        mock_connect.return_value = mock_connection
        mock_connection.cursor.return_value = mock_cursor

        # Simulate cursor.fetchall() for tables with a 'title' column
        mock_cursor.fetchall.return_value = [('table1',), ('table2',)]

        # Simulate the query result for the title (no matching title)
        mock_cursor.execute.side_effect = [
            MagicMock(fetchone=MagicMock(return_value=None)),  # No match in table1
            MagicMock(fetchone=MagicMock(return_value=None))   # No match in table2
        ]

        # Call the function with a title that doesn't exist in any table
        title = 'Nonexistent Title'
        detailed_info, table_name = fetch_data_for_title_dynamic(title)

        # Assert that no data was found and the result is None, None
        self.assertIsNone(detailed_info)
        self.assertIsNone(table_name)


