        # Mock the database connection and cursor
        mock_connection = MagicMock()
        mock_cursor = MagicMock()
        mock_connect.return_value = mock_connection
        mock_connection.cursor.return_value = mock_cursor

        # Simulate cursor.fetchall() returning an empty list (no titles in the folder)
        mock_cursor.fetchall.return_value = []

        # Call the function
        result = get_titles_in_folder("empty_folder")

        # Assert that the result is an empty list since no titles are found
        self.assertEqual(result, [])
        mock_cursor.execute.assert_called_once_with("SELECT title FROM `empty_folder`")



